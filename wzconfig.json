{
  // WzItemArchive 运行配置。相对路径一律按本文件所在目录解析，与启动目录无关。
  // 支持整行 // 注释；不写本文件时程序使用内置默认值（wz、data/mia.db、图标关闭）。
  "db": "data/mia.db",
  "addr": "127.0.0.1:8080",
  "workers": 0,

  // 图标为可选项：enabled=false 时不建索引、不注册 /img 路由、页面也不显示图标列。
  // 实测导出布局：<dir>/<Wz>/<类别>/<id>.img.png，Npc 等无类别层同样能索引到。
  "icons": {
    "enabled": true,
    "dir": "imgdata"
  },

  // 多语言：一个条目 = 一套语言包目录，入库后按 lang 分域，互不覆盖。
  // 只扫指定语言：maplewzmeta scan -lang zh-CN；查询与站点用 ?lang= 切换。
  "locales": [
    {
      "lang": "zh-CN",
      "label": "简体中文",
      "wz": "wz",
      "sources": ["String.wz", "Item.wz", "Character.wz"]
    }

    // 再加一门语言只需补一项，例如：
    // ,{
    //   "lang": "en",
    //   "label": "English",
    //   "wz": "wz-en",
    //   "sources": ["String.wz", "Item.wz", "Character.wz"]
    // }
  ]
}
